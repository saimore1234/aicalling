# ─────────────────────────────────────────────────────────────────────────────
# VMS Smart Calling — environment template.  cp .env.example .env
# Never commit .env. Anything left blank simply leaves that integration "not configured".
# The app starts in DEMO mode: nothing real is dialled or sent until an admin switches to LIVE.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# ── Core ─────────────────────────────────────────────────────────────────────
# Used by docker compose to build DATABASE_URL. For non-Docker runs set DATABASE_URL directly.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql://vms:change-me-to-a-long-random-password@localhost:5432/vms_smart_calling
REDIS_URL=redis://localhost:6379

# REQUIRED in production: random string, 32+ chars (e.g. `openssl rand -hex 32`).
# Signs unsubscribe links and voice-stream tokens. Changing it invalidates both.
APP_SECRET=
# Public https URL of the web app, no trailing slash. Needed so Twilio/Resend/Meta can call the webhooks
# and so webhook signatures can be verified against the exact URL they signed.
APP_URL=https://app.example.com
# One-time token that allows creating the very first administrator at /setup. Remove after setup.
SETUP_TOKEN=
# true when served over HTTPS (session cookie gets the Secure flag).
COOKIE_SECURE=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ── OpenAI (real-time voice + call analysis) ─────────────────────────────────
OPENAI_API_KEY=
# 'ga' for the generally-available Realtime API, 'beta' for the older wire format.
OPENAI_REALTIME_PROTOCOL=ga
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_BASE_URL=            # only for a proxy / compatible gateway

# ── Voice gateway (Twilio Media Streams <-> OpenAI Realtime) ─────────────────
VOICE_GATEWAY_PORT=8081
# Public WSS URL Twilio connects to; must terminate TLS (e.g. behind Caddy/nginx).
VOICE_GATEWAY_PUBLIC_URL=wss://voice.example.com/media-stream

# ── Twilio (voice + SMS) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=            # your verified/purchased number, E.164
TWILIO_SMS_FROM=              # or use a Messaging Service SID below
TWILIO_MESSAGING_SERVICE_SID=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=none           # resend | smtp | none
EMAIL_FROM=
EMAIL_FROM_NAME=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=        # Svix signing secret (whsec_...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── WhatsApp Business Platform (Meta Cloud API) ──────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=          # used to verify X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=        # any random string; paste the same value in the Meta webhook setup
WHATSAPP_API_VERSION=v23.0
